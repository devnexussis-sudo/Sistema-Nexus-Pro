{
  "expo": {
    "name": "Duno",
    "slug": "nexus-mobile",
    "version": "03.01.26",
    "orientation": "portrait",
    "backgroundColor": "#ffffff",
    "icon": "./assets/images/app-icon-duno-v6.png",
    "scheme": "nexusmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexus.mobile",
      "buildNumber": "03.01.26",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Nexus Mobile to use your location to track service routes even when the app is backgrounded.",
        "NSMicrophoneUsageDescription": "Permitir acesso ao microfone para transcrição do relatório.",
        "NSSpeechRecognitionUsageDescription": "Permitir reconhecimento de voz para transcrever o relatório técnico.",
        "NSCameraUsageDescription": "Permitir acesso à câmera para tirar fotos e gravar vídeos de evidências das ordens de serviço.",
        "NSPhotoLibraryUsageDescription": "Permitir acesso à galeria para selecionar fotos de evidências das ordens de serviço."
      }
    },
    "android": {
      "newArchitectureEnabled": false,
      "package": "com.nexus.mobile",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/app-icon-duno-v6.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./withCustomProguard.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-duno-v6.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Nexus Mobile to use your location to track service routes even when the app is backgrounded.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "ndk": {
              "abiFilters": [
                "armeabi-v7a",
                "arm64-v8a"
              ]
            },
            "packagingOptions": {
              "pickFirst": [
                "**/builddef.lst",
                "**/libc++_shared.so",
                "**/META-INF/DEPENDENCIES",
                "**/META-INF/LICENSE",
                "**/META-INF/LICENSE.txt",
                "**/META-INF/NOTICE",
                "**/META-INF/NOTICE.txt",
                "**/META-INF/kotlinx-coroutines-core.kotlin_module"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c9b16e0f-37af-47bd-9ed8-48677de635e2"
      }
    },
    "owner": "duno-up"
  }
}
