+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+
+  <!-- Checked. -->
+  <!-- Uses the on surface state layer since tapping a checked selection control
+      will turn it to the unchecked color. -->
+  <item android:alpha="@dimen/m3_ripple_selectable_pressed_alpha"
+      android:color="?attr/colorOnSurface"
+      android:state_pressed="true" android:state_checked="true"/>
