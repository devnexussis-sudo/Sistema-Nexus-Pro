{
  "name": "nexus-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.5",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.48.1",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.1.0",
    "expo": "~52.0.46",
    "expo-av": "~15.0.2",
    "expo-battery": "~9.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-camera": "~16.0.18",
    "expo-checkbox": "~4.0.1",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.22",
    "expo-screen-orientation": "~8.0.4",
    "expo-speech": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-task-manager": "~12.0.6",
    "expo-video-thumbnails": "~9.0.3",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^0.479.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-calendars": "^1.1314.0",
    "react-native-compressor": "^1.16.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "15.8.0",
    "react-native-video-helper": "^1.5.0",
    "react-native-webview": "13.12.5",
    "react-native-worklets-core": "^1.3.3"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~5.3.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-calendars",
        "react-native-compressor",
        "react-native-signature-canvas",
        "react-native-video-helper",
        "react-native-worklets-core",
        "lucide-react-native",
        "@supabase/supabase-js",
        "date-fns",
        "base64-arraybuffer",
        "@react-navigation/bottom-tabs",
        "@react-navigation/elements",
        "@react-navigation/native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["expo-av", "base64-arraybuffer", "react-native-video-helper"]
      }
    }
  }
